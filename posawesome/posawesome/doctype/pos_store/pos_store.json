{
 "doctype": "DocType",
 "name": "POS Store",
 "module": "POSAwesome",
 "autoname": "hash",
 "naming_rule": "Random",
 "title_field": "store_name",
 "search_fields": "store_code,store_name",
 "field_order": [
  "store_code",
  "store_name",
  "company",
  "status",
  "timezone",
  "business_day_cutoff",
  "address",
  "storefront_sucursal",
  "section_scope",
  "warehouses",
  "profiles",
  "section_meta",
  "policy_version",
  "revision",
  "has_activity",
  "store_key"
 ],
 "fields": [
  {
   "fieldname": "store_code",
   "fieldtype": "Data",
   "label": "Store Code",
   "reqd": 1,
   "length": 32,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "store_name",
   "fieldtype": "Data",
   "label": "Store Name",
   "reqd": 1,
   "length": 120,
   "in_list_view": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nSuspended\nRetired",
   "default": "Active",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "timezone",
   "fieldtype": "Data",
   "label": "Timezone",
   "reqd": 1,
   "default": "America/Mexico_City",
   "length": 64
  },
  {
   "fieldname": "business_day_cutoff",
   "fieldtype": "Time",
   "label": "Business Day Cutoff",
   "default": "00:00:00"
  },
  {
   "fieldname": "address",
   "fieldtype": "Link",
   "label": "Address",
   "options": "Address"
  },
  {
   "fieldname": "storefront_sucursal",
   "fieldtype": "Data",
   "label": "Storefront Sucursal (optional channel link)",
   "length": 140
  },
  {
   "fieldname": "section_scope",
   "fieldtype": "Section Break",
   "label": "Permitted scope"
  },
  {
   "fieldname": "warehouses",
   "fieldtype": "Table",
   "label": "Warehouses",
   "options": "POS Store Warehouse"
  },
  {
   "fieldname": "profiles",
   "fieldtype": "Table",
   "label": "POS Profiles",
   "options": "POS Store Profile"
  },
  {
   "fieldname": "section_meta",
   "fieldtype": "Section Break",
   "label": "Revision"
  },
  {
   "fieldname": "policy_version",
   "fieldtype": "Int",
   "label": "Policy Version",
   "default": "1",
   "read_only": 1
  },
  {
   "fieldname": "revision",
   "fieldtype": "Int",
   "label": "Revision",
   "default": "1",
   "read_only": 1
  },
  {
   "fieldname": "has_activity",
   "fieldtype": "Check",
   "label": "Has Activity",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "store_key",
   "fieldtype": "Data",
   "label": "Store Key",
   "unique": 1,
   "hidden": 1,
   "read_only": 1,
   "length": 200
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "POS User",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "POS Awesome Supervisor",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "report": 1,
   "print": 1
  }
 ],
 "track_changes": 1,
 "allow_copy": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB"
}
