{
 "doctype": "DocType",
 "name": "POS Device Binding",
 "module": "POSAwesome",
 "autoname": "hash",
 "naming_rule": "Random",
 "field_order": [
  "device",
  "register",
  "store",
  "kind",
  "generation",
  "active",
  "started_at",
  "ended_at",
  "authorized_by",
  "reason",
  "end_reason",
  "active_register_key",
  "active_device_key"
 ],
 "fields": [
  {
   "fieldname": "device",
   "fieldtype": "Link",
   "label": "Device",
   "options": "POS Device",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "register",
   "fieldtype": "Link",
   "label": "Register",
   "options": "POS Register",
   "in_list_view": 1
  },
  {
   "fieldname": "store",
   "fieldtype": "Link",
   "label": "Store",
   "options": "POS Store",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "kind",
   "fieldtype": "Select",
   "label": "Kind",
   "options": "Selling\nOrder-only",
   "default": "Selling"
  },
  {
   "fieldname": "generation",
   "fieldtype": "Int",
   "label": "Generation",
   "default": "1"
  },
  {
   "fieldname": "active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "Started At"
  },
  {
   "fieldname": "ended_at",
   "fieldtype": "Datetime",
   "label": "Ended At"
  },
  {
   "fieldname": "authorized_by",
   "fieldtype": "Link",
   "label": "Authorized By",
   "options": "User"
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "Reason"
  },
  {
   "fieldname": "end_reason",
   "fieldtype": "Small Text",
   "label": "End Reason"
  },
  {
   "fieldname": "active_register_key",
   "fieldtype": "Data",
   "label": "Active Register Key",
   "unique": 1,
   "hidden": 1,
   "length": 200
  },
  {
   "fieldname": "active_device_key",
   "fieldtype": "Data",
   "label": "Active Device Key",
   "unique": 1,
   "hidden": 1,
   "length": 200
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "POS User",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "POS Awesome Supervisor",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "report": 1,
   "print": 1
  }
 ],
 "track_changes": 1,
 "allow_copy": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB"
}
