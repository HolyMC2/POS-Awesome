{
 "doctype": "DocType",
 "name": "POS Register Command Receipt",
 "module": "POSAwesome",
 "autoname": "hash",
 "naming_rule": "Random",
 "field_order": [
  "namespace",
  "request_id",
  "receipt_key",
  "payload_hash",
  "actor",
  "store",
  "target_doctype",
  "target_name",
  "status",
  "correlation_id",
  "result_json"
